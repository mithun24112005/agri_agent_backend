# ── Required API Keys ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
HF_TOKEN=your_huggingface_token
TAVILY_API_KEY=your_tavily_api_key
GOOGLE_API_KEY=your_google_api_key_optional

# ── PostgreSQL Checkpoint Database (agri_memory) ─────────
SESSION_CHECKPOINTER_BACKEND=postgres
SESSION_CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agri_memory

# ── External Services ────────────────────────────────────
QDRANT_URL=http://localhost:6333
DISEASE_API_URL=http://127.0.0.1:8000
DISEASE_API_TIMEOUT_SECONDS=30.0
DISEASE_API_CONNECT_TIMEOUT_SECONDS=5.0
DISEASE_CONFIDENCE_THRESHOLD=0.50

# ── Conversation ─────────────────────────────────────────
MAX_CONVERSATION_MESSAGES=20

# ── Internal API Key (must match gateway) ────────────────
INTERNAL_API_SECRET=change_me_internal_secret

# ── Observability (optional) ─────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_key
# LANGSMITH_PROJECT=smart-agriculture
